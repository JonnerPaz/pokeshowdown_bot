generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt?  @unique
  username   String   @unique
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @default(now()) @db.Timestamp(6)
  nickname   String?

  pokeballs   Int       @default(10)
  greatballs  Int       @default(2)
  ultraballs  Int       @default(0)
  masterballs Int       @default(0)
  lastDailyAt DateTime? @db.Timestamp(6)
  dailyStreak Int       @default(0)

  wins           Int   @default(0)
  losses         Int   @default(0)
  buddyPokemonId Int?

  pokemons  Pokemon[]
}

model Pokemon {
  id        Int           @id @default(autoincrement())
  name      String        
  types     String[]
  ability   String
  sprites   Json          @db.Json
  isShiny   Boolean       @default(false)
  createdAt DateTime      @default(now()) @db.Timestamp(6)
  timesCaught Int         @default(1)
  nickname    String?
  isInParty   Boolean       @default(true)
  userId    Int?          @map("user_id")

  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}
