API_KEY="YOUR_API_KEY"
PORT=5000

# Database Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="pokemons"

# Public tunnel URL for webhook mode, e.g. https://<tunnel>.trycloudflare.com
WEBHOOK_URL=""
# Random 32-byte secret that Telegram must send as X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET="generate-a-random-value"
# Default local development URL (matches docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:2300/pokemons?schema=public"
