API_KEY="YOUR_API_KEY"
PORT=5000

# Tunnel connector token (only if you use a tunnel service).
# Only the tunnel service reads it; the bot itself never uses it.
# Leave empty when the tunnel runs outside this stack. Never commit a real token.
TUNNEL_TOKEN=""

# Public URL of the Telegram Mini App (e.g. https://pokebot.example.dev).
# Empty disables the whole web layer: no /api routes and no menu button.
# Telegram only opens web apps over HTTPS, so http:// URLs are ignored.
WEBAPP_URL=""
# Maximum accepted age of the Telegram initData payload, in seconds (default 86400).
# WEBAPP_AUTH_MAX_AGE_SEC="86400"
# Turn deadline for web arena battles, in seconds (default 90).
# ARENA_TURN_TIMEOUT_SEC="90"

# Bot Operational Mode: "polling" (recommended for container platforms, homelabs, dynamic IP) or "webhook"
# If unset, defaults to "polling" if WEBHOOK_URL is omitted, or "webhook" if WEBHOOK_URL is defined.
BOT_MODE="polling"

# Drop queued messages when starting (useful after power outages or server reboot)
DROP_PENDING_UPDATES="true"

# Optional encounter tuning (defaults used if unset/invalid)
# SHINY_ODDS="512"
# SPAWN_POOL_SIZE="1025"

# Database Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="pokemons"

# Hostname of the database container. Keep "db" for the bundled Docker services;
# override it when the bot connects to an external or container-managed database.
DB_HOST="db"
# How many times the container entrypoint retries `prisma migrate deploy`.
# DB_MAX_ATTEMPTS="40"

# Public HTTPS URL for webhook mode (e.g. https://bot.example.com)
# Obtain it from your reverse proxy or tunnel provider (or run `pnpm tunnel`).
WEBHOOK_URL=""

# Secret token (1-256 characters) securing the Telegram webhook.
# Telegram sends this in the 'X-Telegram-Bot-Api-Secret-Token' header.
# Generate a secure string (e.g., run `openssl rand -hex 32` in your terminal)
WEBHOOK_SECRET="generate-a-random-secret-token"

# Database connection URL:
# - Local host development (outside Docker): "postgresql://postgres:postgres@localhost:2300/pokemons?schema=public"
# - Docker Compose (bundled 'db' service): leave unset (defaults to internal db:5432)
# - Docker Compose (external/managed database): set to your managed connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:2300/pokemons?schema=public"
