{
  "name": "showdownbot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\" compose.yaml prisma.config.ts tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\" compose.yaml prisma.config.ts tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.16.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@grammyjs/commands": "^1.2.0",
    "@grammyjs/conversations": "^2.1.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "axios": "^1.13.2",
    "axios-cache-interceptor": "^1.8.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "grammy": "^1.38.4",
    "pg": "^8.17.1",
    "pokenode-ts": "^1.20.0"
  }
}
